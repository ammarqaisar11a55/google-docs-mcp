# Google OAuth 2.0 client credentials (Google Cloud Console → APIs & Services → Credentials).
# Create an OAuth client ID of type "Desktop app". Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Loopback redirect URI used during the one-time sign-in. Must be http://127.0.0.1 or
# http://localhost with an explicit port and path. Desktop-app clients accept any loopback port.
GOOGLE_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback

# Where OAuth tokens are stored (file is created with 0600 permissions).
# Default: ~/.config/google-docs-mcp/tokens.json
# GOOGLE_TOKEN_PATH=

# Drive permission level:
#   drive       (default) full Drive access — required to list/search/copy/trash ALL of your existing Docs
#   drive.file  least privilege — only Docs created or opened by this app are visible
# GOOGLE_DRIVE_SCOPE=drive
# Alternative boolean form (used by the Claude Desktop extension): true = drive.file.
# GOOGLE_DRIVE_SCOPE takes precedence when both are set.
# GOOGLE_DRIVE_FILE_ONLY=false

# Log level written to stderr: error | warn | info | debug (default: info). Secrets are always redacted.
# LOG_LEVEL=info
# GOOGLE_DOCS_MCP_DEBUG=true is a shortcut for LOG_LEVEL=debug.
# GOOGLE_DOCS_MCP_DEBUG=false

# Optional: enables tests/integration/google-api.test.ts against a real (test) Google account.
# RUN_GOOGLE_INTEGRATION_TESTS=true
