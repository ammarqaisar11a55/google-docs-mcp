{
  "name": "google-docs-mcp",
  "version": "1.1.0",
  "description": "A production-ready Model Context Protocol (MCP) server and Claude Desktop extension for Google Docs: create, read, edit, format and search Google Docs from any MCP client.",
  "license": "MIT",
  "author": "Muhammad Ammar Qaisar (https://github.com/ammarqaisar11a55)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ammarqaisar11a55/google-docs-mcp.git"
  },
  "homepage": "https://github.com/ammarqaisar11a55/google-docs-mcp#readme",
  "bugs": "https://github.com/ammarqaisar11a55/google-docs-mcp/issues",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "google-docs-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "mcp",
    "mcpb",
    "model-context-protocol",
    "claude-desktop",
    "google-docs",
    "google-drive"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "auth": "tsx src/index.ts auth",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "validate:manifest": "mcpb validate manifest.json",
    "package": "tsx scripts/package-mcpb.ts",
    "package:check": "tsx scripts/verify-mcpb.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@googleapis/docs": "^13.0.0",
    "@googleapis/drive": "^25.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "google-auth-library": "^11.0.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "tmp": "^0.2.7"
  }
}
